# GeoIP2 示例配置（只允许中国 IP 访问）
#
# 使用前：
#   1. 把本文件复制为 /etc/nginx/conf.d/geoip2.conf（以 .conf 结尾才会被加载）
#   2. 挂载全量 Country 数据库，例如：
#        docker run -v /host/Country-All.mmdb:/etc/nginx/geoip/Country-All.mmdb:ro ...
#   3. 重新加载：docker exec <容器名> nginx -s reload

# 加载全量 Country 库，把国家代码写入变量
geoip2 /etc/nginx/geoip/Country-All.mmdb {
    auto_reload 60m;
    $geoip2_data_country_code country iso_code;
    $geoip2_data_country_name country names zh-CN;
}

server {
    listen 80;
    server_name _;

    # 输出判定结果，用于验证模块是否生效
    location /geoip {
        default_type text/plain;
        return 200 "country_code=$geoip2_data_country_code\n"
                   "country_name=$geoip2_data_country_name\n";
    }

    location / {
        # 只允许中国（CN）：非 CN 一律 403
        # （国外 IP 返回对应国家码、无记录/内网 IP 变量为空，都会被拦截）
        if ($geoip2_data_country_code !~ ^CN$) { return 403; }

        root   /usr/share/nginx/html;
        index  index.html index.htm;
    }
}
